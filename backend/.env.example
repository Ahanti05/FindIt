# FindIt backend – copy to backend/.env and fill in

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Show the seeded demo accounts on the login page (turn off for real use)
DEMO_MODE=true

# ─── MongoDB ────────────────────────────────────────────────────────────
# Local: run "npm run db" (no MongoDB install needed) or your own mongod.
MONGODB_URI=mongodb://127.0.0.1:27017/findit
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/findit

# ─── Auth ───────────────────────────────────────────────────────────────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Only allow sign-ups from these email domains (comma separated). Empty = any.
ALLOWED_EMAIL_DOMAINS=

# ─── AI service (FastAPI) ───────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# Combined-score thresholds (0-1) – see ai-service/matcher.py
MATCH_STORE_MIN=0.45
MATCH_NOTIFY_MIN=0.6

# ─── Image storage ──────────────────────────────────────────────────────
# Leave blank to store images in backend/uploads/ instead of Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (optional, used for password reset) ──────────────────────────
# Without it, development mode shows the reset link on screen instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=FindIt <noreply@findit.campus>

# ─── Rate limiting ──────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=30
